    "verledenTijdA2": {
      "id": "verledenTijdA2",
      "title": "Past Tense - Practice Exercise (A2)",
      "type": "verbConjugation",
      "level": "A2",
      "explanation": "The past tense (imperfectum) is used to talk about what happened in the past. This exercise focuses on common verbs such as 'gaan' (to go), 'zijn' (to be), 'combineren' (to combine), 'besparen' (to save), 'vertrouwen' (to trust), 'logeren' (to stay), and 'verwennen' (to spoil).",
      "keyPoints": [
        "Regular verbs follow 't kofschip rule",
        "Irregular verbs have special forms",
        "Gaan → ging/gingen (irregular verb)",
        "Zijn → was/waren (irregular verb)",
        "Plural always gets -n added",
        "Pay attention to stem spelling"
      ],
      "questions": [
        {
          "id": "vt1",
          "question": "Conjugation of 'maken' (to make): Ik ... elke dag huiswerk.",
          "options": ["maak", "maakt", "maken", "maakte"],
          "correctAnswer": 0,
          "explanation": "For 'ik' use only the stem: maak (maken - en = maak)",
          "hint": "For 'ik' use no ending",
          "difficulty": "easy",
          "tags": ["present-tense", "regular", "A2"],
          "exerciseType": "multipleChoice"
        },
        {
          "id": "vt2",
          "question": "Conjugation of 'wonen' (to live): Hij ... in Utrecht.",
          "options": ["woon", "woont", "wonen", "woonde"],
          "correctAnswer": 1,
          "explanation": "For 'hij' use stem + t: woon + t = woont",
          "hint": "For 'hij/zij' add -t to the stem",
          "difficulty": "easy",
          "tags": ["present-tense", "regular", "A2"],
          "exerciseType": "multipleChoice"
        },
        {
          "id": "vt3",
